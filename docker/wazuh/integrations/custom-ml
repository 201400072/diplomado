#!/usr/bin/env python3
"""
Placeholder para el script de integracion custom ML.

En FASE 10 este script recibira alertas de Wazuh via custom integration,
las transformara a features del modelo XGBoost, llamara a la API /predict
y guardara el resultado en el indice wazuh-ml-* de Wazuh Indexer.

Referencia: https://documentation.wazuh.com/current/user-manual/manager/manual-integration.html
"""
import json
import sys


def main() -> int:
    """Punto de entrada - recibe alerta por stdin (formato Wazuh custom integration)."""
    if len(sys.argv) < 2:
        alert_path = "/tmp/wazuh-alert.json"
    else:
        alert_path = sys.argv[1]

    try:
        with open(alert_path, "r", encoding="utf-8") as fh:
            alert = json.load(fh)
    except (FileNotFoundError, json.JSONDecodeError):
        return 1

    print(json.dumps(alert, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())